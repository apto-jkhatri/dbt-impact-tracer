{
  "name": "dbt-impact-tracer",
  "version": "1.0.0",
  "description": "Visualize dbt dependency paths and run only the models affected by your changes",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.browser.js",
  "bin": {
    "dbt-impact-tracer": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "browser": "./dist/index.browser.js"
    },
    "./utils": "./dist/utils/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .js,.jsx",
    "lint:fix": "eslint src tests --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\"",
    "prepare": "npm run build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "jsdom": "^23.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "dbt",
    "data-build-tool",
    "dependency-graph",
    "impact-analysis",
    "data-engineering",
    "visualization",
    "analytics",
    "sql"
  ],
  "author": "dbt Impact Tracer Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/apto-jkhatri/dbt-impact-tracer.git"
  },
  "homepage": "https://dbt-impact-tracer.dev",
  "bugs": {
    "url": "https://github.com/apto-jkhatri/dbt-impact-tracer/issues"
  },
  "license": "MIT"
}
